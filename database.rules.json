{
  "rules": {
    ".read": false,
    ".write": false,
    "tvs": {
      "$tv": {
        "hostUid": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && $tv.matches(/^[A-Za-z0-9]{12,40}$/)"
        },
        "online": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('tvs').child($tv).child('hostUid').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "snapshot": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('tvs').child($tv).child('hostUid').val() === auth.uid"
        },
        "inbox": {
          ".read": "auth != null && root.child('tvs').child($tv).child('hostUid').val() === auth.uid",
          "$msg": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('tvs').child($tv).child('hostUid').exists()) || (!newData.exists() && root.child('tvs').child($tv).child('hostUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['type', 'uid', 'sentAt']) && ((newData.child('type').val() === 'add' && newData.hasChildren(['videoId', 'title', 'singer'])) || (newData.child('type').val() === 'remove' && newData.hasChild('itemId')))",
            "type": { ".validate": "newData.val() === 'add' || newData.val() === 'remove'" },
            "uid": { ".validate": "newData.val() === auth.uid" },
            "sentAt": { ".validate": "newData.val() === now" },
            "videoId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/)" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "channel": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "thumb": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "singer": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
            "itemId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
